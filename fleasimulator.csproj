<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <Version>2.0.1</Version>
        <!-- The two lines below will set the output path for the binaries -->
        <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    
    <PropertyGroup Condition="$(Configuration) == Release">
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
        <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
        <PackageReference Include="SPTushonka.Reflection" Version="4.1.3" />
        <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
    </ItemGroup>
    
    <ItemGroup>
        <None Update="Presets/default.jsonc">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target  Name="PostBuild" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <CompileFiles Include="$(TargetDir)*.deps.json;$(TargetDir)*.endpoints.json" />
        </ItemGroup>
        <Delete Files="@(CompileFiles)" />
        <Exec Command="cp -a $(TargetDir) $(SolutionDir)../../SPT_Runtime/user/mods/" />
    </Target>

</Project>
