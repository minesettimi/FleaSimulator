      //keys vary wildly, add any keys that don't fit the standard preset
      //marked keys
      "5780cf7f2459777de4559322": "OmegaRare",
      "5d80c62a86f7744036212b3f": "ExtremelyRare",
      "5d80c60f86f77440373c4ece": "ExtremelyRare",
