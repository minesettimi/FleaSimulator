      "5ad5d7d286f77450166e0a89": "SuperRare",
      
      //streets
      "6582dbf0b8d7830efc45016f": "SuperRare",
      
      //shoreline
      
      
      //nowhere keys
      "5913651986f774432f15d132": "Common",
      
      //some keycards are valued worse
      //interchange cards
      "5e42c81886f7742a01529f57": "Rare",
